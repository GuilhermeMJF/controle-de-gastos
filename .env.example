# Copie para .env e ajuste se quiser trocar as credenciais do banco
POSTGRES_USER=gastos
POSTGRES_PASSWORD=gastos
POSTGRES_DB=gastos

# Chave que assina os tokens de login. Use um valor longo e aleatório.
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio

# Opcional: envio de e-mails pelo Brevo (recuperação de senha).
# Sem isso, o link de redefinição aparece no terminal da API.
BREVO_API_KEY=
EMAIL_REMETENTE=
